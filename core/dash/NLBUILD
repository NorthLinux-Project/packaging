pkgname="dash"
pkgver="0.5.12"
pkgdesc="POSIX-compliant Unix shell designed for speed and small footprint"
url="http://gondor.apana.org.au/~herbert/dash/"
arch="x86_64"
license=("BSD-3-Clause")
depends=("glibc>=2.30")
conflicts=()
provides=("sh")
sources=("http://gondor.apana.org.au/~herbert/dash/files/dash-0.5.12.tar.gz")
sha256sums=("6a474ac46e8b0b32916c4c60df694c82058d3297d8b385b74508030ca4a8f28a")

build() {
    cd "${srcdir}/dash-${pkgver}"
    ./configure \
        --prefix=/usr \
        --bindir=/bin \
        --mandir=/usr/share/man
    make -j"$(nproc)"
}

package() {
    cd "${srcdir}/dash-${pkgver}"
    make DESTDIR="${pkgdir}" install
}
